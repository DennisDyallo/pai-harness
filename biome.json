{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useConst": "error"
			}
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
	}
}
